+++ b/agent/systemd_windows.go
@@ -0,0 +1,285 @@
+//go:build windows
+
+package agent
+
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"path"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/henrygd/beszel/agent/utils"
+	"github.com/henrygd/beszel/internal/entities/systemd"
+	"golang.org/x/sys/windows"
+	"golang.org/x/sys/windows/svc"
+	"golang.org/x/sys/windows/svc/mgr"
+)
+
+// systemdManager retains the existing internal name so Windows service data can
+// use Beszel's service records and UI without a database migration.
+type systemdManager struct {
+	sync.Mutex
+	serviceStatsMap map[string]*systemd.Service
+	hasFreshStats   bool
+	patterns        []string
+}
+
+func newSystemdManager() (*systemdManager, error) {
+	if skipServices, _ := utils.GetEnv("SKIP_SYSTEMD"); skipServices == "true" {
+		return nil, nil
+	}
+	manager := &systemdManager{
+		serviceStatsMap: make(map[string]*systemd.Service),
+		patterns:        getWindowsServicePatterns(),
+	}
+	if len(manager.patterns) == 0 {
+		slog.Warn("Windows service monitoring disabled until SERVICE_PATTERNS is explicitly configured")
+		return nil, nil
+	}
+	if err := manager.refresh(); err != nil {
+		return nil, err
+	}
+	go manager.startWorker()
+	return manager, nil
+}
+
+func (sm *systemdManager) startWorker() {
+	for {
+		time.Sleep(10 * time.Minute)
+		if err := sm.refresh(); err != nil {
+			slog.Debug("Error refreshing Windows services", "err", err)
+		}
+	}
+}
+
+func (sm *systemdManager) getServiceStatsCount() int {
+	sm.Lock()
+	defer sm.Unlock()
+	return len(sm.serviceStatsMap)
+}
+
+func (sm *systemdManager) getFailedServiceCount() uint16 {
+	sm.Lock()
+	defer sm.Unlock()
+	var count uint16
+	for _, service := range sm.serviceStatsMap {
+		if service.State == systemd.StatusFailed {
+			count++
+		}
+	}
+	return count
+}
+
+func (sm *systemdManager) getServiceStats(_ any, refresh bool) []*systemd.Service {
+	if refresh {
+		if err := sm.refresh(); err != nil {
+			slog.Debug("Error refreshing Windows services", "err", err)
+			return nil
+		}
+	}
+
+	sm.Lock()
+	defer sm.Unlock()
+	services := make([]*systemd.Service, 0, len(sm.serviceStatsMap))
+	for _, service := range sm.serviceStatsMap {
+		copy := *service
+		services = append(services, &copy)
+	}
+	slices.SortFunc(services, func(a, b *systemd.Service) int {
+		return strings.Compare(strings.ToLower(a.Name), strings.ToLower(b.Name))
+	})
+	sm.hasFreshStats = false
+	return services
+}
+
+func (sm *systemdManager) refresh() error {
+	manager, err := connectWindowsServiceManager()
+	if err != nil {
+		return fmt.Errorf("connect to Windows service manager: %w", err)
+	}
+	defer manager.Disconnect()
+
+	names, err := manager.ListServices()
+	if err != nil {
+		return fmt.Errorf("list Windows services: %w", err)
+	}
+
+	fresh := make(map[string]*systemd.Service, len(names))
+	for _, name := range names {
+		windowsService, err := openWindowsService(manager, name)
+		if err != nil {
+			continue
+		}
+		config, configErr := windowsService.Config()
+		status, statusErr := windowsService.Query()
+		windowsService.Close()
+		if statusErr != nil {
+			continue
+		}
+		displayName := ""
+		if configErr == nil {
+			displayName = config.DisplayName
+		}
+		if !matchesWindowsService(sm.patterns, name, displayName) {
+			continue
+		}
+		state, subState := windowsServiceState(status, config, configErr)
+		fresh[name] = &systemd.Service{Name: name, State: state, Sub: subState}
+	}
+
+	sm.Lock()
+	sm.serviceStatsMap = fresh
+	sm.hasFreshStats = true
+	sm.Unlock()
+	return nil
+}
+
+func (sm *systemdManager) getServiceDetails(serviceName string) (systemd.ServiceDetails, error) {
+	if strings.TrimSpace(serviceName) == "" {
+		return nil, errors.New("service name is required")
+	}
+	manager, err := connectWindowsServiceManager()
+	if err != nil {
+		return nil, err
+	}
+	defer manager.Disconnect()
+
+	windowsService, err := openWindowsService(manager, serviceName)
+	if err != nil {
+		return nil, err
+	}
+	defer windowsService.Close()
+
+	config, configErr := windowsService.Config()
+	status, err := windowsService.Query()
+	if err != nil {
+		return nil, err
+	}
+	state, subState := windowsServiceState(status, config, configErr)
+	details := systemd.ServiceDetails{
+		"ActiveState": serviceStateText(state),
+		"SubState":    serviceSubStateText(subState),
+		"Result":      serviceStateText(state),
+	}
+	if configErr == nil {
+		details["Description"] = config.Description
+		details["DisplayName"] = config.DisplayName
+		// BinaryPathName may contain credentials or tokens in command-line
+		// arguments. Never transmit it to the hub. The service account is also
+		// unnecessary for availability monitoring and may identify a user.
+		details["StartType"] = config.StartType
+		details["Dependencies"] = config.Dependencies
+	}
+	return details, nil
+}
+
+func connectWindowsServiceManager() (*mgr.Mgr, error) {
+	handle, err := windows.OpenSCManager(
+		nil,
+		nil,
+		windows.SC_MANAGER_CONNECT|windows.SC_MANAGER_ENUMERATE_SERVICE,
+	)
+	if err != nil {
+		return nil, err
+	}
+	return &mgr.Mgr{Handle: handle}, nil
+}
+
+func openWindowsService(manager *mgr.Mgr, name string) (*mgr.Service, error) {
+	namePointer, err := windows.UTF16PtrFromString(name)
+	if err != nil {
+		return nil, err
+	}
+	handle, err := windows.OpenService(
+		manager.Handle,
+		namePointer,
+		windows.SERVICE_QUERY_CONFIG|windows.SERVICE_QUERY_STATUS,
+	)
+	if err != nil {
+		return nil, err
+	}
+	return &mgr.Service{Name: name, Handle: handle}, nil
+}
+
+func windowsServiceState(status svc.Status, config mgr.Config, configErr error) (systemd.ServiceState, systemd.ServiceSubState) {
+	switch status.State {
+	case svc.Running:
+		return systemd.StatusActive, systemd.SubStateRunning
+	case svc.StartPending, svc.ContinuePending:
+		return systemd.StatusActivating, systemd.SubStateUnknown
+	case svc.StopPending, svc.PausePending:
+		return systemd.StatusDeactivating, systemd.SubStateUnknown
+	case svc.Paused:
+		return systemd.StatusInactive, systemd.SubStateUnknown
+	case svc.Stopped:
+		// A stopped automatic service is actionable; manual and disabled
+		// services are simply inactive.
+		if configErr == nil && config.StartType == mgr.StartAutomatic {
+			return systemd.StatusFailed, systemd.SubStateFailed
+		}
+		return systemd.StatusInactive, systemd.SubStateDead
+	default:
+		return systemd.StatusInactive, systemd.SubStateUnknown
+	}
+}
+
+func serviceStateText(state systemd.ServiceState) string {
+	switch state {
+	case systemd.StatusActive:
+		return "active"
+	case systemd.StatusFailed:
+		return "failed"
+	case systemd.StatusActivating:
+		return "activating"
+	case systemd.StatusDeactivating:
+		return "deactivating"
+	case systemd.StatusReloading:
+		return "reloading"
+	default:
+		return "inactive"
+	}
+}
+
+func serviceSubStateText(state systemd.ServiceSubState) string {
+	switch state {
+	case systemd.SubStateRunning:
+		return "running"
+	case systemd.SubStateExited:
+		return "exited"
+	case systemd.SubStateFailed:
+		return "failed"
+	case systemd.SubStateUnknown:
+		return "unknown"
+	default:
+		return "dead"
+	}
+}
+
+func getWindowsServicePatterns() []string {
+	value, _ := utils.GetEnv("SERVICE_PATTERNS")
+	patterns := make([]string, 0)
+	for pattern := range strings.SplitSeq(value, ",") {
+		if pattern = strings.TrimSpace(pattern); pattern != "" {
+			patterns = append(patterns, strings.ToLower(pattern))
+		}
+	}
+	return patterns
+}
+
+func matchesWindowsService(patterns []string, name, displayName string) bool {
+	name = strings.ToLower(name)
+	displayName = strings.ToLower(displayName)
+	for _, pattern := range patterns {
+		if matched, _ := path.Match(pattern, name); matched {
+			return true
+		}
+		if matched, _ := path.Match(pattern, displayName); matched {
+			return true
+		}
+	}
+	return false
+}
