+//go:build windows
+
+package agent
+
+import (
+	"bufio"
+	"encoding/csv"
+	"io"
+	"log/slog"
+	"math"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+	"syscall"
+
+	"github.com/henrygd/beszel/internal/entities/system"
+)
+
+var windowsGPUEnginePattern = regexp.MustCompile(`(?i)luid_(0x[0-9a-f]+_0x[0-9a-f]+)_phys_(\d+)_eng_(\d+)`)
+
+// startWindowsGPUCounterFallback uses Windows' GPU Engine performance counters
+// when older NVIDIA drivers expose the card through nvidia-smi but return
+// "Not Supported" for utilization. It does not replace temperature or memory
+// collection from the vendor collector.
+func (gm *GPUManager) startWindowsGPUCounterFallback() bool {
+	if _, err := exec.LookPath("typeperf.exe"); err != nil {
+		return false
+	}
+
+	go func() {
+		cmd := exec.Command(
+			"typeperf.exe",
+			`\GPU Engine(*)\Utilization Percentage`,
+			"-si", "4",
+		)
+		cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			slog.Debug("Windows GPU counter unavailable", "err", err)
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			slog.Debug("Windows GPU counter unavailable", "err", err)
+			return
+		}
+
+		if err := gm.readWindowsGPUCounter(stdout); err != nil {
+			slog.Debug("Windows GPU counter stopped", "err", err)
+		}
+		_ = cmd.Wait()
+	}()
+	return true
+}
+
+func (gm *GPUManager) readWindowsGPUCounter(reader io.Reader) error {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+
+	var columns [][2]string // adapter id, engine id
+	for scanner.Scan() {
+		record, err := csv.NewReader(strings.NewReader(scanner.Text())).Read()
+		if err != nil || len(record) < 2 {
+			continue
+		}
+
+		if columns == nil {
+			columns = make([][2]string, len(record))
+			for i := 1; i < len(record); i++ {
+				match := windowsGPUEnginePattern.FindStringSubmatch(record[i])
+				if len(match) == 4 {
+					columns[i] = [2]string{match[1] + "/" + match[2], match[3]}
+				}
+			}
+			continue
+		}
+
+		engineTotals := make(map[string]map[string]float64)
+		for i := 1; i < len(record) && i < len(columns); i++ {
+			gpuID, engineID := columns[i][0], columns[i][1]
+			if gpuID == "" {
+				continue
+			}
+			value, err := strconv.ParseFloat(strings.TrimSpace(record[i]), 64)
+			if err != nil || math.IsNaN(value) || math.IsInf(value, 0) {
+				continue
+			}
+			if engineTotals[gpuID] == nil {
+				engineTotals[gpuID] = make(map[string]float64)
+			}
+			engineTotals[gpuID][engineID] += value
+		}
+
+		usage := 0.0
+		for _, engines := range engineTotals {
+			for _, value := range engines {
+				usage = max(usage, value)
+			}
+		}
+
+		gm.Lock()
+		if gm.fallbackUsage == nil {
+			gm.fallbackUsage = make(map[string]float64)
+		}
+		gm.fallbackUsage["0"] = min(usage, 100)
+		if len(gm.GpuDataMap) == 0 {
+			gm.GpuDataMap["0"] = &system.GPUData{Name: "Windows GPU"}
+		}
+		gm.Unlock()
+	}
+	return scanner.Err()
+}
