+//go:build windows
+
+package agent
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/henrygd/beszel/internal/entities/system"
+)
+
+func TestWindowsGPUCounterParser(t *testing.T) {
+	manager := &GPUManager{GpuDataMap: map[string]*system.GPUData{
+		"0": {Name: "Test GPU"},
+	}}
+	input := strings.Join([]string{
+		`"PDH-CSV 4.0","\\\\HOST\\GPU Engine(pid_1_luid_0x00000000_0x0000D780_phys_0_eng_0_engtype_3D)\\Utilization Percentage","\\\\HOST\\GPU Engine(pid_2_luid_0x00000000_0x0000D780_phys_0_eng_0_engtype_3D)\\Utilization Percentage","\\\\HOST\\GPU Engine(pid_3_luid_0x00000000_0x0000D780_phys_0_eng_1_engtype_Copy)\\Utilization Percentage"`,
+		`"08/18/2026 17:00:00.000","7.5","5.0","3.0"`,
+	}, "\n")
+	if err := manager.readWindowsGPUCounter(strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if got := manager.GetCurrentData(0)["0"].Usage; got != 12.5 {
+		t.Fatalf("expected max engine utilization 12.5, got %v", got)
+	}
+}
+
+func TestWindowsGPUCounterCreatesFallbackGPU(t *testing.T) {
+	manager := &GPUManager{GpuDataMap: make(map[string]*system.GPUData)}
+	input := strings.Join([]string{
+		`"PDH-CSV 4.0","\\\\HOST\\GPU Engine(pid_1_luid_0x00000000_0x0000D780_phys_0_eng_0_engtype_3D)\\Utilization Percentage"`,
+		`"08/18/2026 17:00:00.000","6.25"`,
+	}, "\n")
+	if err := manager.readWindowsGPUCounter(strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	gpu := manager.GetCurrentData(0)["0"]
+	if gpu.Name != "Windows GPU" || gpu.Usage != 6.25 {
+		t.Fatalf("expected Windows GPU at 6.25%%, got %#v", gpu)
+	}
+}
+
+func TestWindowsServiceCollection(t *testing.T) {
+	t.Setenv("SERVICE_PATTERNS", "BeszelAgent")
+	manager, err := newSystemdManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if manager == nil {
+		t.Fatal("expected Windows service manager")
+	}
+	services := manager.getServiceStats(nil, false)
+	if len(services) == 0 {
+		t.Fatal("expected at least one Windows service")
+	}
+}
