{
  "schema_version": 1,
  "state_root": "C:/Docker/maintenance/update-state",
  "defaults": {
    "mode": "audit-only"
  },
  "controller_path_patterns": [
    "(?i)[/\\\\]artifacts[/\\\\]",
    "(?i)[/\\\\]coolify[/\\\\](applications|services)[/\\\\]"
  ],
  "projects": {
    "example-stack": {
      "mode": "manual",
      "services": {
        "example-app": {
          "enabled": true,
          "backup_required": true,
          "backup_paths": [
            "C:/Docker/example-stack/config"
          ],
          "health_url": "http://127.0.0.1:18080/health",
          "health_timeout_seconds": 180
        }
      }
    },
    "controller-owned-example": {
      "owner": "controller",
      "mode": "controller-managed",
      "controller": "coolify"
    }
  }
}
