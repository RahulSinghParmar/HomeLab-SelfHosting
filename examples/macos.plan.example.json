{
  "schema_version": 1,
  "example_only": true,
  "installation_id": "example-lab",
  "platform": "macos",
  "architecture": "arm64",
  "mode": "fresh",
  "access": "loopback",
  "services": ["glance", "uptime-kuma"],
  "paths": {
    "installation_root": "/Users/example/Homelab/Installation",
    "media_root": "/Users/example/Homelab/Media",
    "backup_root": "/Volumes/Backup/Homelab"
  },
  "database_storage": "docker-named-volumes",
  "resource_budget": {"cpu_limit": 4, "memory_gib": 6, "reserve_host_gib": 4},
  "gpu": "disabled",
  "public_domain": null,
  "secret_bundle": "external-encrypted-bundle-required",
  "retention": {"daily": 7, "weekly": 4, "monthly": 3}
}
