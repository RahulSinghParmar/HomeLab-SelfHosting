{
  "schema_version": 1,
  "example_only": true,
  "installation_id": "example-lab",
  "platform": "linux",
  "architecture": "amd64",
  "mode": "fresh",
  "access": "loopback",
  "services": ["glance", "uptime-kuma", "paperless-ngx"],
  "paths": {
    "installation_root": "/srv/homelab/installation",
    "media_root": "/srv/homelab/media",
    "backup_root": "/mnt/backup/homelab"
  },
  "database_storage": "docker-named-volumes",
  "resource_budget": {"cpu_limit": 4, "memory_gib": 6, "reserve_host_gib": 4},
  "gpu": "disabled",
  "public_domain": null,
  "secret_bundle": "external-encrypted-bundle-required",
  "retention": {"daily": 7, "weekly": 4, "monthly": 3}
}
